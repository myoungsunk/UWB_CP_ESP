+                        int.from_bytes(ab[16:20], 'little') != config or
+                        int.from_bytes(ab[20:24], 'little') != boots.get('anchor') or
+                        int.from_bytes(ab[24:28], 'little') != (0 if index == 0 else boots.get('tag'))):
